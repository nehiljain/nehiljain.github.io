// Sends www.nehiljain.dev to nehiljain.dev. Deployed next to the site by .github/workflows/deploy.yml.
{
  "name": "nehiljain-www-redirect",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "www.nehiljain.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
