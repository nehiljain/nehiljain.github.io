// Cloudflare Worker that serves the static export in out/ at nehiljain.dev.
// Deployed by .github/workflows/deploy.yml on every push to master.
{
  "name": "nehiljain-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "nehiljain.dev", "custom_domain": true }],
  // One public copy only: no *.workers.dev address and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false
}
